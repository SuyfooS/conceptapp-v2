# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys
# and never paste them into a chat.

# Supabase (phase 0, chunk 3). URL: the Connect button in the dashboard.
# Local development: API_URL and PUBLISHABLE_KEY from `pnpm exec supabase status -o env`.
# Keys: Settings > API Keys. Use the new publishable/secret keys; the legacy
# anon and service_role keys are being retired by the end of 2026.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: bypasses every RLS policy. Set in Vercel as Sensitive, never
# with a NEXT_PUBLIC_ prefix, never in the browser bundle. It also keys the
# clock's six-digit codes (packages/db/punch-key.ts): nothing else to set.
SUPABASE_SECRET_KEY=

# The demo door on this site: on (the default when unset) or off. Off on the
# site of real businesses: /enter goes straight to sign-in, with no demo
# people, no demo sign-in and no demo reset. On at the demo's own address.
# Read when the site is built: Redeploy after a change (docs/production.md).
DEMO_DOOR=

# Cloudflare Turnstile ("אני לא רובוט") before every SMS code: the widget's
# Site Key, public (it is in every page that sends a code). Unset: Cloudflare's
# always-passing test key, for local, CI and e2e, where Supabase's CAPTCHA is
# off. In Vercel: Production and Preview, then Redeploy (docs/production.md,
# Turnstile). Read when the site is built. Never the Secret Key: that goes to
# Supabase only (Authentication → Attack Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ConceptApp's team on WhatsApp, for "עזרה" on /me: owners, managers and the
# accountant of a real business get "וואטסאפ לצוות של ConceptApp" with it.
# E.164 only: a plus, the country code and the number, no spaces or dashes.
# Unset, or not in that form: "עזרה" offers only whom to ask in the business
# (the log says when it is set but not E.164). Server only. Never in the
# repo: in Vercel, Production, then Redeploy (docs/production.md, B11).
SUPPORT_WHATSAPP=

# Notifications on the phone (Web Push). Without these three the app still
# notifies inside the app and says nothing about it; nothing reaches a phone.
# Make a pair with
#   node tooling/vapid-keys.mjs
# and never reuse a development pair in production. The private key is a
# secret (Sensitive in Vercel); the public one is what browsers subscribe with.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services may contact: mailto:… or https://…
VAPID_SUBJECT=
# Server-only: the database's jobs call /cron/notifications, /cron/list-photos
# and /cron/chat-files with it.
# Its own random value, 32 characters or more, also kept in Supabase Vault as
# cron_secret. Never SUPABASE_SECRET_KEY: pg_net's queue is readable by any
# database login, and this one only lets someone send what is already due.
CRON_SECRET=
# Tests only: the loopback mock push service the browser tests stand up
# (e2e/push.spec.ts). Ignored on Vercel.
PUSH_TEST_ORIGIN=

# The hiring file's encryption (server only: Sensitive, Production only in
# Vercel, never with a NEXT_PUBLIC_ prefix). Without both, the file can't be
# read or written; only how complete each file is still shows. Make a key with
#   node tooling/employee-data-key.mjs
# and keep a copy in a password manager: a lost key makes every file unreadable.
# A rotation lists the old keys before the new one (1:…,2:…) and moves the
# active id.
EMPLOYEE_DATA_KEKS=
EMPLOYEE_DATA_KEK_ACTIVE=
