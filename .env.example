# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys
# and never paste them into a chat.

# Supabase (phase 0, chunk 3). URL: the Connect button in the dashboard.
# Local development: API_URL and PUBLISHABLE_KEY from `pnpm exec supabase status -o env`.
# Keys: Settings > API Keys. Use the new publishable/secret keys; the legacy
# anon and service_role keys are being retired by the end of 2026.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: bypasses every RLS policy. Set in Vercel as Sensitive, never
# with a NEXT_PUBLIC_ prefix, never in the browser bundle. It also keys the
# clock's six-digit codes (packages/db/punch-key.ts): nothing else to set.
SUPABASE_SECRET_KEY=

# Notifications on the phone (Web Push). Without these three the app still
# notifies inside the app and says nothing about it; nothing reaches a phone.
# Make a pair with
#   node tooling/vapid-keys.mjs
# and never reuse a development pair in production. The private key is a
# secret (Sensitive in Vercel); the public one is what browsers subscribe with.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services may contact: mailto:… or https://…
VAPID_SUBJECT=
# Server-only: the database's minute job calls /cron/notifications with it.
# Its own random value, 32 characters or more, also kept in Supabase Vault as
# cron_secret. Never SUPABASE_SECRET_KEY: pg_net's queue is readable by any
# database login, and this one only lets someone send what is already due.
CRON_SECRET=
# Tests only: the loopback mock push service the browser tests stand up
# (e2e/push.spec.ts). Ignored on Vercel.
PUSH_TEST_ORIGIN=
