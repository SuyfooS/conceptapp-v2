# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys
# and never paste them into a chat.

# Supabase (phase 0, chunk 3) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Set in Vercel project settings, not in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
