{
  "name": "conceptapp-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "biome check && next typegen && tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/database.types.ts && biome format --write packages/db/database.types.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@hebcal/core": "^6.14.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "qr": "0.7.2",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "postgres": "^3.4.9",
    "supabase": "2.118.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
